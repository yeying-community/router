{
  "name": "react-template",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@yeying-community/web3-bs": "^1.0.28",
    "antd": "^6.3.7",
    "axios": "^0.27.2",
    "history": "^5.3.0",
    "i18next": "23.16.8",
    "i18next-browser-languagedetector": "^8.0.2",
    "marked": "^4.1.1",
    "moment": "^2.30.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-i18next": "15.5.0",
    "react-router-dom": "^7.0.0",
    "react-toastify": "^9.0.8",
    "react-turnstile": "^1.0.5",
    "recharts": "^2.15.1"
  },
  "scripts": {
    "start": "vite",
    "check": "npm run test:write-paged-rows && npm run test:list-state && npm run test:wallet-session && npm run test:chart-theme && npm run test:theme-store && npm run test:csv && npm run test:billing-format && npm run test:channel-purchase && npm run check:router-ui && npm run check:popover-safety && npm run check:chart-palette && npm run check:i18n && npm run check:i18n-cjk && vite build",
    "build": "node ./scripts/check-router-ui-boundary.mjs && node ./scripts/check-popover-select-safety.mjs && node ./scripts/check-chart-palette.mjs && node ./scripts/check-i18n-line-align.mjs && node ./scripts/scan-hardcoded-i18n.mjs && vite build",
    "test:write-paged-rows": "node ./tests/write-paged-rows.test.mjs",
    "test:list-state": "node ./tests/list-state.test.mjs",
    "test:wallet-session": "node ./tests/wallet-session.test.mjs",
    "test:chart-theme": "node ./tests/chart-theme.test.mjs",
    "test:theme-store": "node ./tests/theme-store.test.mjs",
    "test:csv": "node ./tests/csv.test.mjs",
    "test:billing-format": "node ./tests/billing-format.test.mjs",
    "test:channel-purchase": "node ./tests/channel-purchase.test.mjs",
    "check:router-ui": "node ./scripts/check-router-ui-boundary.mjs",
    "check:popover-safety": "node ./scripts/check-popover-select-safety.mjs",
    "check:chart-palette": "node ./scripts/check-chart-palette.mjs",
    "check:i18n": "node ./scripts/check-i18n-line-align.mjs",
    "check:i18n-cjk": "node ./scripts/scan-hardcoded-i18n.mjs",
    "dev": "vite",
    "preview": "vite preview"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^2.7.1",
    "typescript": "4.9.5",
    "vite": "^5.4.14"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote": true
  }
}
